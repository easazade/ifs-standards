{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifs-standards.org/schemas/v1/entities/label.schema.json",
  "title": "Label",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "description": "Globally unique identifier for this label."
    },
    "ifsId": {
      "type": "string",
      "default": "com.ifs.entity.label",
      "description": "Stable IFS entity identifier for Label."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this label was created."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when this label was last updated."
    }
  },
  "required": ["id", "ifsId", "createdAt", "updatedAt"]
}
